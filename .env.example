# Copy to .env for local development. Never commit the real file.

# Required in any deployed environment.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-only-not-for-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Leave unset to use SQLite. Set to a POOLED Postgres URL in production.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Domain settings (all optional; defaults in config/settings.py)
# DEALS_DB_PATH=deals.db
# DEALS_CACHE_TTL=60
# DEALS_PAGE_SIZE=20
# DEALS_IDEMPOTENCY_TTL=86400
# DEALS_CURRENCY=INR
